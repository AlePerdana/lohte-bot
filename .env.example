# ETHOL Bot — Environment Variables
# Salin ke .env lalu isi. Cukup ini saja — sisanya auto/default.

# ===== Login ETHOL (WAJIB) =====
ETHOL_LOGIN_USERNAME=
ETHOL_LOGIN_PASSWORD=

# ===== Notifikasi WhatsApp (opsional) =====
WA_ENABLED=false
WA_PROVIDER=callmebot
WA_TARGET=
WA_APIKEY=

# ===== Presensi =====
# Interval random polling dalam detik: min,max
PRESENSI_INTERVAL=5,60